{
  "name": "shared",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "arktype": "^2.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^22.13.1"
  }
}
