import type React from 'react';

export interface ButtonProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  isLoading?: boolean;
}

/**
 * Maha Button — uses shared design tokens from @<%= it.projectName %>/design-tokens.
 *
 * CSS classes are defined in the shared components.css:
 *   .mha-btn, .mha-btn-primary, .mha-btn-sm, etc.
 */
export const Button: React.FC<ButtonProps> = ({
  children,
  variant = 'primary',
  size = 'md',
  isLoading = false,
  disabled,
  className = '',
  ...props
}) => {
  const variantClass = {
    primary: 'mha-btn-primary',
    secondary: 'mha-btn-secondary',
    outline: 'mha-btn-outline',
    ghost: 'mha-btn-ghost',
    danger: 'mha-btn-danger',
  }[variant];

  const sizeClass = `mha-btn-${size}`;

  return (
    <button
      className={`mha-btn ${variantClass} ${sizeClass} ${className}`}
      disabled={disabled || isLoading}
      {...props}
    >
      {isLoading ? (
        <span className="flex items-center gap-2">
          <svg className="mha-spinner mha-spinner-sm" fill="none" viewBox="0 0 24 24">
            <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" />
            <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
          </svg>
          Loading...
        </span>
      ) : (
        children
      )}
    </button>
  );
};
