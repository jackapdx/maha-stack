{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run --watch --no-clear-screen src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "@hono/node-server": "^1.15.2",
    "@trpc/server": "^11.16.0",
    "arktype": "^2.2.0",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^22.13.1",
    "@types/cors": "^2.8.17"
  }
}
