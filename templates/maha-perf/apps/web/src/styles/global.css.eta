@import "tailwindcss";

/* ════════════════════════════════════════════════════════════════════════
   🎨 MAHA Design Tokens (from shared-ui/styles/tokens.css)
   ════════════════════════════════════════════════════════════════════════ */

@theme {
  /* Maha Brand Colours (Gold → Orange → Ember) */
  --color-maha-50: #FFF8E1;
  --color-maha-100: #FFECB3;
  --color-maha-200: #FFE082;
  --color-maha-300: #FFD54F;
  --color-maha-400: #FFCA28;
  --color-maha-500: #FFD700;
  --color-maha-600: #FFB300;
  --color-maha-700: #FF8C00;
  --color-maha-800: #FF6D00;
  --color-maha-900: #E65100;

  /* Surface / Neutral palette */
  --color-surface-50: #FAFAFA;
  --color-surface-100: #F5F5F5;
  --color-surface-200: #EEEEEE;
  --color-surface-300: #E0E0E0;
  --color-surface-400: #BDBDBD;
  --color-surface-500: #9E9E9E;
  --color-surface-600: #757575;
  --color-surface-700: #616161;
  --color-surface-800: #424242;
  --color-surface-900: #212121;
  --color-surface-950: #121212;

  /* Typography */
  --font-family-sans: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Helvetica Neue", Arial, sans-serif;
  --font-family-mono: "JetBrains Mono", "Fira Code", "Cascadia Code", "SF Mono", Consolas,
    "Liberation Mono", Menlo, monospace;

  /* Border radius */
  --radius-maha-sm: 0.375rem;
  --radius-maha-md: 0.5rem;
  --radius-maha-lg: 0.75rem;
  --radius-maha-xl: 1rem;

  /* Shadows */
  --shadow-maha-sm: 0 1px 2px 0 rgb(0 0 0 / 0.04), 0 1px 3px 0 rgb(0 0 0 / 0.06);
  --shadow-maha-md: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.08);
  --shadow-maha-lg: 0 10px 15px -3px rgb(0 0 0 / 0.06), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --shadow-maha-xl: 0 20px 25px -5px rgb(0 0 0 / 0.08), 0 8px 10px -6px rgb(0 0 0 / 0.1);

  /* Animations */
  --animate-maha-fade-in: maha-fade-in 0.25s ease-out;
  --animate-maha-slide-up: maha-slide-up 0.3s ease-out;
  --animate-maha-slide-down: maha-slide-down 0.3s ease-out;
  --animate-maha-scale-in: maha-scale-in 0.2s ease-out;
  --animate-maha-spin-slow: spin 3s linear infinite;

  /* Focus ring */
  --ring-color-maha: var(--color-maha-500);
}

@keyframes maha-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes maha-slide-up {
  from { transform: translateY(12px); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}
@keyframes maha-slide-down {
  from { transform: translateY(-12px); opacity: 0; }
  to   { transform: translateY(0);     opacity: 1; }
}
@keyframes maha-scale-in {
  from { transform: scale(0.95); opacity: 0; }
  to   { transform: scale(1);    opacity: 1; }
}

@utility transition-maha {
  transition-property: color, background-color, border-color, outline-color, text-decoration-color,
    fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

@utility focus-ring-maha {
  @apply focus:outline-none focus:ring-2 focus:ring-maha-500 focus:ring-offset-2;
}

/* ════════════════════════════════════════════════════════════════════════
   🧩 MAHA Shared Components (from shared-ui/styles/components.css)
   ════════════════════════════════════════════════════════════════════════ */

@layer components {
  .mha-btn {
    @apply inline-flex items-center justify-center font-medium rounded-lg transition-maha
           cursor-pointer select-none focus-ring-maha disabled:opacity-50 disabled:cursor-not-allowed;
  }
  .mha-btn-primary { @apply bg-maha-600 text-white hover:bg-maha-700 active:bg-maha-800; }
  .mha-btn-secondary { @apply bg-surface-200 text-surface-800 hover:bg-surface-300 active:bg-surface-400; }
  .mha-btn-outline { @apply border border-surface-300 text-surface-700 hover:bg-surface-100 active:bg-surface-200; }
  .mha-btn-ghost { @apply text-surface-600 hover:bg-surface-100 active:bg-surface-200; }
  .mha-btn-danger { @apply bg-red-600 text-white hover:bg-red-700 active:bg-red-800; }
  .mha-btn-sm  { @apply px-3 py-1.5 text-sm gap-1.5; }
  .mha-btn-md  { @apply px-4 py-2 text-base gap-2; }
  .mha-btn-lg  { @apply px-6 py-3 text-lg gap-2.5; }
  .mha-btn-icon { @apply p-2 rounded-full aspect-square; }

  .mha-card { @apply bg-white rounded-xl border border-surface-200 shadow-maha-sm; }
  .mha-card-header { @apply px-6 py-4 border-b border-surface-200; }
  .mha-card-body { @apply px-6 py-5; }
  .mha-card-footer { @apply px-6 py-4 border-t border-surface-200 bg-surface-50 rounded-b-xl; }
  .mha-card-title { @apply text-lg font-semibold text-surface-900; }
  .mha-card-subtitle { @apply mt-1 text-sm text-surface-500; }

  .mha-badge { @apply inline-flex items-center font-medium rounded-full; }
  .mha-badge-sm { @apply text-xs px-2 py-0.5; }
  .mha-badge-md { @apply text-sm px-2.5 py-0.5; }
  .mha-badge-lg { @apply text-base px-3 py-1; }
  .mha-badge-default { @apply bg-surface-100 text-surface-700; }
  .mha-badge-primary { @apply bg-maha-100 text-maha-800; }
  .mha-badge-success { @apply bg-green-100 text-green-800; }
  .mha-badge-danger { @apply bg-red-100 text-red-800; }
  .mha-badge-warning { @apply bg-amber-100 text-amber-800; }
  .mha-badge-info { @apply bg-blue-100 text-blue-800; }
  .mha-badge-outline { @apply bg-transparent border border-surface-300 text-surface-700; }
  .mha-badge-dot { @apply before:inline-block before:w-2 before:h-2 before:rounded-full before:me-1.5; }

  .mha-alert { @apply relative rounded-lg border p-4; }
  .mha-alert-info { @apply bg-sky-50 border-sky-200 text-sky-800; }
  .mha-alert-success { @apply bg-green-50 border-green-200 text-green-800; }
  .mha-alert-warning { @apply bg-amber-50 border-amber-200 text-amber-800; }
  .mha-alert-error { @apply bg-red-50 border-red-200 text-red-800; }
  .mha-alert-title { @apply text-sm font-medium; }
  .mha-alert-body { @apply mt-1 text-sm; }

  .mha-spinner { @apply animate-spin text-maha-600; }
  .mha-spinner-sm { @apply size-4; }
  .mha-spinner-md { @apply size-6; }
  .mha-spinner-lg { @apply size-8; }
  .mha-spinner-xl { @apply size-12; }
  .mha-spinner-secondary { @apply text-surface-500; }
  .mha-spinner-success { @apply text-green-600; }
  .mha-spinner-danger { @apply text-red-600; }
  .mha-spinner-warning { @apply text-amber-600; }

  .mha-input {
    @apply block w-full rounded-lg border border-surface-300 bg-white px-3 py-2 text-sm
           text-surface-900 placeholder:text-surface-400 transition-maha focus-ring-maha
           disabled:bg-surface-100 disabled:text-surface-400 disabled:cursor-not-allowed;
  }
  .mha-input-error { @apply border-red-500 focus:ring-red-500; }
  .mha-label { @apply block text-sm font-medium text-surface-700 mb-1; }
  .mha-hint { @apply mt-1 text-xs text-surface-500; }
  .mha-error-text { @apply mt-1 text-xs text-red-600; }

  .mha-select {
    @apply block w-full rounded-lg border border-surface-300 bg-white px-3 py-2 pr-10 text-sm
           text-surface-900 appearance-none transition-maha focus-ring-maha
           bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2220%22%20height%3D%2220%22%20fill%3D%22none%22%20stroke%3D%22%239CA3AF%22%20stroke-width%3D%222%22%3E%3Cpath%20d%3D%22m6%208%204%204%204-4%22%2F%3E%3C%2Fsvg%3E')]
           bg-[length:1.25rem_1.25rem] bg-[right_0.5rem_center] bg-no-repeat
           disabled:bg-surface-100 disabled:text-surface-400 disabled:cursor-not-allowed;
  }

  .mha-modal-overlay { @apply fixed inset-0 z-50 flex items-center justify-center bg-black/40 animate-maha-fade-in; }
  .mha-modal { @apply bg-white rounded-xl shadow-maha-xl max-w-lg w-full mx-4 animate-maha-scale-in; }
  .mha-modal-header { @apply flex items-center justify-between px-6 py-4 border-b border-surface-200; }
  .mha-modal-body { @apply px-6 py-5; }
  .mha-modal-footer { @apply flex items-center justify-end gap-2 px-6 py-4 border-t border-surface-200; }

  .mha-table { @apply w-full text-left text-sm text-surface-700; }
  .mha-table thead { @apply bg-surface-50 text-surface-600 text-xs uppercase tracking-wider; }
  .mha-table th { @apply px-4 py-3 font-medium; }
  .mha-table td { @apply px-4 py-3 border-t border-surface-100; }
  .mha-table tbody tr { @apply transition-maha hover:bg-surface-50; }

  .mha-tabs { @apply flex gap-0 border-b border-surface-200; }
  .mha-tab { @apply px-4 py-2.5 text-sm font-medium text-surface-500 border-b-2 border-transparent transition-maha cursor-pointer hover:text-surface-700 hover:border-surface-300; }
  .mha-tab-active { @apply text-maha-700 border-maha-600; }

  .mha-empty { @apply flex flex-col items-center justify-center py-16 text-center; }
  .mha-empty-icon { @apply size-12 text-surface-300 mb-4; }
  .mha-empty-title { @apply text-lg font-medium text-surface-700; }
  .mha-empty-description { @apply mt-1 text-sm text-surface-500 max-w-sm; }

  .mha-divider { @apply w-full border-t border-surface-200; }
  .mha-divider-label { @apply flex items-center gap-3 text-xs text-surface-400 uppercase tracking-wider; }
  .mha-divider-label::before,
  .mha-divider-label::after { content: ""; @apply flex-1 border-t border-surface-200; }

  .mha-skeleton { @apply animate-pulse bg-surface-200 rounded; }
  .mha-skeleton-text { @apply h-4 w-full; }
  .mha-skeleton-title { @apply h-6 w-3/4; }
  .mha-skeleton-avatar { @apply size-10 rounded-full; }
  .mha-skeleton-button { @apply h-10 w-24 rounded-lg; }
}

/* ════════════════════════════════════════════════════════════════════════
   App-specific styles
   ════════════════════════════════════════════════════════════════════════ */

body {
  margin: 0;
  font-family: var(--font-family-sans);
  min-width: 320px;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background-color: var(--color-surface-50);
  color: var(--color-surface-900);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}
