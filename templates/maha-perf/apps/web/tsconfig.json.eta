{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node", "bun"],
    "paths": {
      "api": ["../api/src/index.ts"],
      "shared": ["../../packages/shared/src/index.ts"],
      "ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src"]
}
