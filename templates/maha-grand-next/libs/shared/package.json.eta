{
  "name": "@<%= it.projectName.toLowerCase().replace(/[^a-z0-9]/g, '-') %>/shared",
  "version": "0.0.1",
  "description": "Shared utilities, DTOs, and types for <%= it.projectName %>",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}