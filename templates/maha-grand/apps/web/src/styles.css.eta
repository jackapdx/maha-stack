@import "tailwindcss";

/* ════════════════════════════════════════════════════════════════════════
   🎨 MAHA Design Tokens & Components
   ════════════════════════════════════════════════════════════════════════ */

@theme {
  --color-maha-50: #FFF8E1;
  --color-maha-100: #FFECB3;
  --color-maha-200: #FFE082;
  --color-maha-300: #FFD54F;
  --color-maha-400: #FFCA28;
  --color-maha-500: #FFD700;
  --color-maha-600: #FFB300;
  --color-maha-700: #FF8C00;
  --color-maha-800: #FF6D00;
  --color-maha-900: #E65100;
  --color-surface-50: #FAFAFA;
  --color-surface-100: #F5F5F5;
  --color-surface-200: #EEEEEE;
  --color-surface-300: #E0E0E0;
  --color-surface-400: #BDBDBD;
  --color-surface-500: #9E9E9E;
  --color-surface-600: #757575;
  --color-surface-700: #616161;
  --color-surface-800: #424242;
  --color-surface-900: #212121;
  --color-surface-950: #121212;
  --font-family-sans: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Helvetica Neue", Arial, sans-serif;
  --font-family-mono: "JetBrains Mono", "Fira Code", "Cascadia Code", "SF Mono", Consolas,
    "Liberation Mono", Menlo, monospace;
  --radius-maha-sm: 0.375rem;
  --radius-maha-md: 0.5rem;
  --radius-maha-lg: 0.75rem;
  --radius-maha-xl: 1rem;
  --shadow-maha-sm: 0 1px 2px 0 rgb(0 0 0 / 0.04), 0 1px 3px 0 rgb(0 0 0 / 0.06);
  --shadow-maha-md: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.08);
  --shadow-maha-lg: 0 10px 15px -3px rgb(0 0 0 / 0.06), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  --shadow-maha-xl: 0 20px 25px -5px rgb(0 0 0 / 0.08), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  --animate-maha-fade-in: maha-fade-in 0.25s ease-out;
  --animate-maha-slide-up: maha-slide-up 0.3s ease-out;
  --animate-maha-slide-down: maha-slide-down 0.3s ease-out;
  --animate-maha-scale-in: maha-scale-in 0.2s ease-out;
  --animate-maha-spin-slow: spin 3s linear infinite;
  --ring-color-maha: var(--color-maha-500);
}

@keyframes maha-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes maha-slide-up { from { transform: translateY(12px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes maha-slide-down { from { transform: translateY(-12px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes maha-scale-in { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }

@utility transition-maha {
  transition-property: color, background-color, border-color, outline-color, text-decoration-color,
    fill, stroke, opacity, box-shadow, transform, filter, backdrop-filter;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  transition-duration: 150ms;
}

@utility focus-ring-maha {
  &:focus { outline: none; }
  &:focus { ring: 2px solid var(--color-maha-500); }
  &:focus { ring-offset: 2px; }
}

/* ── Shared component CSS classes ── */
@layer components {
  .mha-btn { @apply inline-flex items-center justify-center font-medium rounded-lg transition-maha cursor-pointer select-none focus-ring-maha disabled:opacity-50 disabled:cursor-not-allowed; }
  .mha-btn-primary { @apply bg-maha-600 text-white hover:bg-maha-700 active:bg-maha-800; }
  .mha-btn-secondary { @apply bg-surface-200 text-surface-800 hover:bg-surface-300 active:bg-surface-400; }
  .mha-btn-outline { @apply border border-surface-300 text-surface-700 hover:bg-surface-100 active:bg-surface-200; }
  .mha-btn-ghost { @apply text-surface-600 hover:bg-surface-100 active:bg-surface-200; }
  .mha-btn-danger { @apply bg-red-600 text-white hover:bg-red-700 active:bg-red-800; }
  .mha-btn-sm  { @apply px-3 py-1.5 text-sm gap-1.5; }
  .mha-btn-md  { @apply px-4 py-2 text-base gap-2; }
  .mha-btn-lg  { @apply px-6 py-3 text-lg gap-2.5; }
  .mha-btn-icon { @apply p-2 rounded-full aspect-square; }
  .mha-card { @apply bg-white rounded-xl border border-surface-200 shadow-maha-sm; }
  .mha-card-header { @apply px-6 py-4 border-b border-surface-200; }
  .mha-card-body { @apply px-6 py-5; }
  .mha-card-footer { @apply px-6 py-4 border-t border-surface-200 bg-surface-50 rounded-b-xl; }
  .mha-card-title { @apply text-lg font-semibold text-surface-900; }
  .mha-card-subtitle { @apply mt-1 text-sm text-surface-500; }
  .mha-badge { @apply inline-flex items-center font-medium rounded-full; }
  .mha-badge-sm { @apply text-xs px-2 py-0.5; }
  .mha-badge-md { @apply text-sm px-2.5 py-0.5; }
  .mha-badge-lg { @apply text-base px-3 py-1; }
  .mha-badge-default { @apply bg-surface-100 text-surface-700; }
  .mha-badge-primary { @apply bg-maha-100 text-maha-800; }
  .mha-badge-success { @apply bg-green-100 text-green-800; }
  .mha-badge-danger { @apply bg-red-100 text-red-800; }
  .mha-badge-warning { @apply bg-amber-100 text-amber-800; }
  .mha-badge-info { @apply bg-blue-100 text-blue-800; }
  .mha-badge-outline { @apply bg-transparent border border-surface-300 text-surface-700; }
  .mha-alert { @apply relative rounded-lg border p-4; }
  .mha-alert-info { @apply bg-sky-50 border-sky-200 text-sky-800; }
  .mha-alert-success { @apply bg-green-50 border-green-200 text-green-800; }
  .mha-alert-warning { @apply bg-amber-50 border-amber-200 text-amber-800; }
  .mha-alert-error { @apply bg-red-50 border-red-200 text-red-800; }
  .mha-spinner { @apply animate-spin text-maha-600; }
  .mha-spinner-sm { @apply size-4; }  .mha-spinner-md { @apply size-6; }
  .mha-spinner-lg { @apply size-8; }  .mha-spinner-xl { @apply size-12; }
  .mha-spinner-secondary { @apply text-surface-500; }
  .mha-spinner-success { @apply text-green-600; }
  .mha-spinner-danger { @apply text-red-600; }
  .mha-spinner-warning { @apply text-amber-600; }
  .mha-input { @apply block w-full rounded-lg border border-surface-300 bg-white px-3 py-2 text-sm text-surface-900 placeholder:text-surface-400 transition-maha focus-ring-maha disabled:bg-surface-100 disabled:text-surface-400 disabled:cursor-not-allowed; }
  .mha-modal-overlay { @apply fixed inset-0 z-50 flex items-center justify-center bg-black/40 animate-maha-fade-in; }
  .mha-modal { @apply bg-white rounded-xl shadow-maha-xl max-w-lg w-full mx-4 animate-maha-scale-in; }
  .mha-table { @apply w-full text-left text-sm text-surface-700; }
  .mha-table thead { @apply bg-surface-50 text-surface-600 text-xs uppercase tracking-wider; }
  .mha-table th { @apply px-4 py-3 font-medium; }
  .mha-table td { @apply px-4 py-3 border-t border-surface-100; }
  .mha-table tbody tr { @apply transition-maha hover:bg-surface-50; }
  .mha-skeleton { @apply animate-pulse bg-surface-200 rounded; }
  .mha-skeleton-title { @apply h-6 w-3/4; }
  .mha-skeleton-avatar { @apply size-10 rounded-full; }
  .mha-skeleton-button { @apply h-10 w-24 rounded-lg; }
  .mha-prose { @apply text-surface-700 leading-relaxed; }
}

/* ── Standard Tailwind utility classes (JIT safelist for Angular) ── */
@layer utilities {
  .flex { @apply flex; } .inline-flex { @apply inline-flex; } .flex-1 { @apply flex-1; }
  .flex-col { @apply flex-col; } .flex-grow { @apply flex-grow; }
  .items-center { @apply items-center; } .justify-center { @apply justify-center; }
  .justify-between { @apply justify-between; }
  .w-full { @apply w-full; } .h-16 { @apply h-16; }
  .min-h-screen { @apply min-h-screen; } .max-w-6xl { width: 72rem; }
  .max-w-3xl { width: 48rem; } .max-w-2xl { max-width: 42rem; } .max-w-sm { max-width: 24rem; }
  .max-w-lg { max-width: 32rem; } .mx-auto { @apply mx-auto; }
  .text-center { @apply text-center; }
  .grid { @apply grid; } .grid-cols-2 { @apply grid-cols-2; } .grid-cols-3 { @apply grid-cols-3; }
  .gap-4 { @apply gap-4; } .gap-8 { @apply gap-8; } .gap-6 { @apply gap-6; } .gap-2 { @apply gap-2; }
  .gap-3 { @apply gap-3; } .gap-1\.5 { @apply gap-1.5; } .gap-2\.5 { @apply gap-2.5; }
  .px-4 { @apply px-4; } .px-6 { @apply px-6; } .px-3 { @apply px-3; } .px-2 { @apply px-2; }
  .px-2\.5 { @apply px-2.5; }
  .py-2 { @apply py-2; } .py-3 { @apply py-3; } .py-4 { @apply py-4; } .py-5 { @apply py-5; }
  .py-6 { @apply py-6; } .py-8 { @apply py-8; } .py-24 { @apply py-24; }
  .py-1\.5 { @apply py-1.5; } .py-0\.5 { @apply py-0.5; }
  .p-4 { @apply p-4; } .p-6 { @apply p-6; } .p-3 { @apply p-3; } .p-2 { @apply p-2; }
  .pt-16 { @apply pt-16; } .pb-8 { @apply pb-8; }
  .mt-1 { @apply mt-1; } .mt-3 { @apply mt-3; } .mt-4 { @apply mt-4; }
  .mt-6 { @apply mt-6; } .mt-8 { @apply mt-8; } .mt-10 { @apply mt-10; }
  .mt-12 { @apply mt-12; } .mr-2 { @apply mr-2; } .mr-3 { @apply mr-3; }
  .ml-3 { @apply ml-3; } .ml-auto { @apply ml-auto; }
  .mb-1 { @apply mb-1; } .mb-2 { @apply mb-2; } .mb-3 { @apply mb-3; }
  .mb-4 { @apply mb-4; } .mb-6 { @apply mb-6; } .mb-8 { @apply mb-8; } .mb-12 { @apply mb-16; }
  .pl-3 { @apply pl-3; } .pl-5 { @apply pl-5; }
  .space-y-1 { @apply space-y-1; } .space-y-3 { @apply space-y-3; }
  .space-y-4 { @apply space-y-4; } .space-y-6 { @apply space-y-6; }
  .text-xs { @apply text-xs; } .text-sm { @apply text-sm; } .text-base { @apply text-base; }
  .text-lg { @apply text-lg; } .text-xl { @apply text-xl; } .text-2xl { @apply text-2xl; }
  .text-3xl { @apply text-3xl; } .text-4xl { @apply text-4xl; } .text-5xl { @apply text-5xl; }
  .text-6xl { @apply text-6xl; }
  .font-normal { @apply font-normal; } .font-medium { @apply font-medium; }
  .font-semibold { @apply font-semibold; } .font-bold { @apply font-bold; }
  .leading-relaxed { @apply leading-relaxed; } .tracking-tight { @apply tracking-tight; }
  .tracking-wider { @apply tracking-wider; } .uppercase { @apply uppercase; }
  .text-white { @apply text-white; }
  .text-surface-400 { @apply text-surface-400; } .text-surface-500 { @apply text-surface-500; }
  .text-surface-600 { @apply text-surface-600; } .text-surface-700 { @apply text-surface-700; }
  .text-surface-800 { @apply text-surface-800; } .text-surface-900 { @apply text-surface-900; }
  .text-maha-600 { @apply text-maha-600; } .text-maha-700 { @apply text-maha-700; }
  .text-red-600 { @apply text-red-600; } .text-green-600 { @apply text-green-600; }
  .text-green-500 { @apply text-green-500; } .text-blue-800 { @apply text-blue-800; }
  .text-indigo-600 { @apply text-indigo-600; } .text-gray-500 { @apply text-gray-500; }
  .text-gray-600 { @apply text-gray-600; } .text-gray-700 { @apply text-gray-700; }
  .text-gray-900 { @apply text-gray-900; }
  .bg-white { @apply bg-white; } .bg-surface-50 { @apply bg-surface-50; }
  .bg-surface-100 { @apply bg-surface-100; } .bg-surface-200 { @apply bg-surface-200; }
  .bg-maha-100 { @apply bg-maha-100; } .bg-maha-600 { @apply bg-maha-600; }
  .bg-blue-50 { @apply bg-blue-50; } .bg-gray-50 { @apply bg-gray-50; }
  .bg-gray-200 { @apply bg-gray-200; } .bg-green-50 { @apply bg-green-50; }
  .bg-red-50 { @apply bg-red-50; } .bg-red-100 { @apply bg-red-100; }
  .bg-indigo-100 { @apply bg-indigo-100; } .bg-indigo-600 { @apply bg-indigo-600; }
  .bg-black\/40 { @apply bg-black/40; } .bg-white\/80 { @apply bg-white/80; }
  .bg-white\/60 { @apply bg-white/60; }
  .bg-transparent { @apply bg-transparent; } .bg-gradient-to-r { @apply bg-gradient-to-r; }
  .from-maha-600 { @apply from-maha-600; } .via-maha-700 { @apply via-maha-700; }
  .to-maha-800 { @apply to-maha-800; } .bg-clip-text { @apply bg-clip-text; }
  .text-transparent { @apply text-transparent; }
  .rounded { @apply rounded; } .rounded-lg { @apply rounded-lg; }
  .rounded-xl { @apply rounded-xl; } .rounded-full { @apply rounded-full; }
  .border { @apply border; } .border-t { @apply border-t; } .border-b { @apply border-b; }
  .border-surface-100 { @apply border-surface-100; }
  .border-surface-200 { @apply border-surface-200; }
  .border-surface-300 { @apply border-surface-300; } .border-gray-200 { @apply border-gray-200; }
  .border-gray-300 { @apply border-gray-300; } .border-transparent { @apply border-transparent; }
  .border-l-4 { @apply border-l-4; }
  .shadow { @apply shadow; } .shadow-sm { @apply shadow-sm; }
  .shadow-maha-sm { @apply shadow-maha-sm; } .shadow-maha-xl { @apply shadow-maha-xl; }
  .container { @apply container; }
  .fixed { @apply fixed; } .relative { @apply relative; }
  .inset-0 { @apply inset-0; } .top-0 { @apply top-0; } .left-0 { @apply left-0; } .right-0 { @apply right-0; }
  .z-50 { @apply z-50; } .sr-only { @apply sr-only; }
  .animate-spin { @apply animate-spin; } .animate-pulse { @apply animate-pulse; }
  .animate-maha-fade-in { @apply animate-maha-fade-in; }
  .animate-maha-slide-up { @apply animate-maha-slide-up; }
  .animate-maha-scale-in { @apply animate-maha-scale-in; }
  .opacity-25 { @apply opacity-25; } .opacity-50 { @apply opacity-75; }
  .opacity-75 { @apply opacity-75; }
  .size-4 { @apply size-4; } .size-5 { @apply size-5; } .size-6 { @apply size-6; }
  .size-8 { @apply size-8; } .size-10 { @apply size-10; } .size-12 { @apply size-12; }
  .h-4 { @apply h-4; } .h-5 { @apply h-5; } .h-6 { @apply h-6; } .h-8 { @apply h-8; }
  .h-10 { @apply h-10; } .h-12 { @apply h-12; } .w-4 { @apply w-4; } .w-5 { @apply w-5; }
  .w-6 { @apply w-6; } .w-8 { @apply w-8; } .w-10 { @apply w-10; } .w-12 { @apply w-12; }
  .w-24 { @apply w-24; } .w-3\/4 { @apply w-3/4; }
  .backdrop-blur { @apply backdrop-blur; } .backdrop-blur-md { @apply backdrop-blur-md; }
  .cursor-pointer { @apply cursor-pointer; } .cursor-not-allowed { @apply cursor-not-allowed; }
  .select-none { @apply select-none; }
  .overflow-hidden { @apply overflow-hidden; }
  .list-disc { @apply list-disc; } .pl-5 { @apply pl-5; }
  .transition-all { @apply transition-all; }
  .hover\:text-maha-700:hover { @apply text-maha-700; }
  .hover\:text-surface-600:hover { @apply text-surface-600; }
  .hover\:bg-surface-50:hover { @apply bg-surface-50; }
  .hover\:bg-surface-100:hover { @apply bg-surface-100; }
  .hover\:bg-surface-300:hover { @apply bg-surface-300; }
  .hover\:bg-indigo-700:hover { @apply bg-indigo-700; }
  .hover\:border-surface-300:hover { @apply border-surface-300; }
  .disabled\:opacity-50:disabled { @apply opacity-50; }
  .disabled\:cursor-not-allowed:disabled { @apply cursor-not-allowed; }
  .focus\:outline-none:focus { outline: none; }
  .aspect-square { @apply aspect-square; }
  .block { @apply block; }
  .appearance-none { @apply appearance-none; }
}

/* ════════════════════════════════════════════════════════════════════════
   App-specific styles
   ════════════════════════════════════════════════════════════════════════ */

body {
  font-family: var(--font-family-sans);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background-color: var(--color-surface-50);
  color: var(--color-surface-900);
  margin: 0;
  min-height: 100vh;
}

.router-link-active {
  @apply text-maha-700 font-medium;
}

::-webkit-scrollbar { width: 10px; }
::-webkit-scrollbar-track { @apply bg-surface-100; }
::-webkit-scrollbar-thumb { @apply bg-surface-300 rounded-full; }
::-webkit-scrollbar-thumb:hover { @apply bg-surface-400; }

.mha-prose h2 { @apply text-2xl font-bold text-surface-900 mt-8 mb-4; }
.mha-prose h3 { @apply text-xl font-semibold text-surface-900 mt-6 mb-3; }
.mha-prose p { @apply mb-4; }
.mha-prose ul { @apply list-disc pl-5 mb-4; }
.mha-prose li { @apply mb-2; }

*, *::before, *::after { box-sizing: border-box; }
