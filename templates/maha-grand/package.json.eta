{
  "name": "<%= it.projectName %>",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "nx run-many --target=serve --projects=api,web",
    "dev": "concurrently \"nx serve api\" \"nx serve web\"",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "oxlint --deny-warnings",
    "typecheck": "nx run-many --target=typecheck --all",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "prepare": "husky"<% if (it.enableOnboarding) { %>,
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:fix": "oxlint --fix --deny-warnings"<% } %>
  },
  "dependencies": {
    "@angular/core": "^21.2.7",
    "@angular/common": "^21.2.7",
    "@angular/compiler": "^21.2.7",
    "@angular/platform-browser": "^21.2.7",
    "@angular/platform-browser-dynamic": "^21.2.7",
    "@angular/router": "^21.2.7",
    "@angular/forms": "^21.2.7",
    "@nestjs/core": "^11.1.19",
    "@nestjs/common": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "bcrypt": "^5.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "@trpc/server": "^11.16.0",
    "@trpc/client": "^11.16.0",
    "zod": "^4.3.6",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "rxjs": "^7.8.2",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.0.9",
    "@tailwindcss/postcss": "^4.0.9"
  },
  "devDependencies": {
    "@nx/angular": "^22.6.5",
    "@nx/nest": "^22.6.5",
    "@nx/js": "^22.6.5",
    "@nx/workspace": "^22.6.5",
    "@angular-devkit/build-angular": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.7",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.1.19",
    "@types/node": "^22.13.1",
    "@types/express": "^5.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.3.0",
    "typescript": "^5.8.0",
    "nx": "^22.6.5",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "oxlint": "^1.62.0"<% if (it.enableOnboarding) { %>,
    "oxfmt": "^0.47.0",
    "lint-staged": "^16.4.0"<% } %>
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "bcrypt",
      "esbuild",
      "less",
      "lmdb",
      "msgpackr-extract",
      "nx",
      "unrs-resolver"
    ]
  }
}
