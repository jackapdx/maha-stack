{
  "name": "prototype-grand-next",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "nx run-many --target=serve --projects=api,web",
    "dev": "nx run-many --target=serve --projects=api,web --parallel=2",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "oxlint --deny-warnings",
    "typecheck": "nx run-many --target=typecheck --all",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "prepare": "husky",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:fix": "oxlint --fix --deny-warnings"
  },
  "dependencies": {
    "@angular/core": "^21.2.12",
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/platform-browser": "^21.2.12",
    "@angular/platform-browser-dynamic": "^21.2.12",
    "@angular/router": "^21.2.12",
    "@angular/forms": "^21.2.12",
    "@nestjs/core": "^11.1.19",
    "@nestjs/common": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "bcrypt": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "@trpc/server": "^11.17.0",
    "@trpc/client": "^11.17.0",
    "zod": "^4.4.3",
    "class-validator": "^0.15.1",
    "class-transformer": "^0.5.1",
    "rxjs": "^7.8.2",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0"
  },
  "devDependencies": {
    "@nx/angular": "^22.7.1",
    "@nx/nest": "^22.7.1",
    "@nx/js": "^22.7.1",
    "@nx/workspace": "^22.7.1",
    "@nx/vite": "^22.7.1",
    "@nx/vitest": "^22.7.1",
    "@oxc-angular/vite": "^0.0.28",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.1.19",
    "@types/node": "^22.15.0",
    "@types/express": "^5.0.6",
    "@types/bcrypt": "^6.0.0",
    "@types/passport-jwt": "^4.0.0",
    "typescript": "^5.8.0",
    "nx": "^22.7.1",
    "husky": "^9.1.7",
    "oxlint": "^1.63.0",
    "oxfmt": "^0.48.0",
    "lint-staged": "^17.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "bcrypt",
      "esbuild",
      "less",
      "lmdb",
      "msgpackr-extract",
      "nx",
      "unrs-resolver",
      "@oxc-angular/vite"
    ],
    "overrides": {
      "tar": ">=7.5.11",
      "axios": ">=1.15.2",
      "brace-expansion": ">=5.0.5",
